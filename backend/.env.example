# ============================================================
# APPLICATION
# ============================================================

APP_ENV=development
APP_NAME=hhgoa-fraud-agent
APP_VERSION=0.1.0
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated browser origins allowed to call the API cross-origin
# (the frontend's `npm run dev` default). Add your deployed frontend URL
# here too if you host it somewhere other than localhost.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ============================================================
# TIGERGRAPH
# ============================================================

# TigerGraph Savanna REST endpoint.
# Read this from your Savanna workspace page — do NOT guess it.
# Typical Savanna form: https://<workspace-id>.<region>.<domain>
TG_HOST=https://YOUR_TIGERGRAPH_HOST

# The graph name created inside Database-1
TG_GRAPHNAME=YOUR_GRAPH_NAME

# Username/password authentication if used
TG_USERNAME=YOUR_TIGERGRAPH_USERNAME
TG_PASSWORD=YOUR_TIGERGRAPH_PASSWORD

# Optional GSQL secret
TG_SECRET=

# Preferred token authentication if generated
TG_API_TOKEN=

# Optional JWT token
TG_JWT_TOKEN=

# TigerGraph REST++ port
TG_RESTPP_PORT=443

# TigerGraph GSQL port
TG_GS_PORT=14240

# SSL port
TG_SSL_PORT=443

# Required for Savanna / TigerGraph Cloud
TG_TGCLOUD=true

# Optional certificate
TG_CERT_PATH=


# ============================================================
# TIGERGRAPH MCP
# ============================================================

TG_MCP_PROFILE=default

# stdio is preferred for local development
TG_MCP_TRANSPORT=stdio

# Only required if running MCP over HTTP
TG_MCP_HOST=127.0.0.1
TG_MCP_PORT=8001

# --- Tool governance (read by tigergraph-mcp itself) -------------
# The official server exposes 116 tools, including destructive ones.
# The investigation agent is given read-only graph access; schema
# creation and loading run through scripts, not the agent.
# Selectors: read-only | destructive | schema | data | query |
#            vector | loading | utility | discovery | <tool name>
# These are set programmatically by app/mcp/config.py when the server
# is launched. Set them here only to override that default.
# TG_ALLOWED_TOOLS=read-only
# TG_BLOCKED_TOOLS=drop_graph,clear_graph_data,drop_all_data_sources

# Note: tigergraph-mcp selects its connection profile with TG_PROFILE,
# not TG_MCP_PROFILE. app/mcp/config.py translates between the two.


# ============================================================
# LLM
# ============================================================

OPENAI_API_KEY=YOUR_OPENAI_API_KEY

OPENAI_MODEL=YOUR_MODEL

# Optional: OpenAI-compatible gateway (Azure, OpenRouter, local vLLM, ...)
OPENAI_BASE_URL=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2


# ============================================================
# EMBEDDINGS / GRAPHRAG
# ============================================================

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL


# ============================================================
# APPLICATION DATABASE
# ============================================================

# Use SQLite for initial development unless another database
# is genuinely required.

DATABASE_URL=sqlite:///./data/fraud_agent.db


# ============================================================
# VECTOR MEMORY
# ============================================================

VECTOR_STORE=local

VECTOR_DB_PATH=./data/vector_store


# ============================================================
# DATASET
# ============================================================

DATASET_ROOT=./data/hhgoa

TRANSACTIONS_PATH=./data/hhgoa/transactions

CASES_PATH=./data/hhgoa/cases

POLICIES_PATH=./data/hhgoa/policies

BENCHMARK_PATH=./data/hhgoa/benchmark


# ============================================================
# MOCK / SAFETY SWITCHES
# ============================================================

# When true, customer validation, step-up auth and analyst
# requests are simulated. No external system is contacted.
MOCK_EXTERNAL_ACTIONS=true

# When true, graph calls are served from local fixtures so unit
# tests run with no network. Set false to use real TigerGraph.
MOCK_TIGERGRAPH=false

# When true, the agent may only run read-only graph queries.
TG_READ_ONLY=false
