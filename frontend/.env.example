# Phase 2L - frontend configuration.
#
# Copy this file to .env.local and point it at a running backend API
# (see ../backend/docs/phase-2-api.md "Startup"). No real secret ever
# belongs in this file - the frontend never holds a TigerGraph or LLM
# credential; it only ever talks to this one HTTP URL.

NEXT_PUBLIC_API_URL=http://localhost:8000
